# Supabase (Project Settings -> API). Without these the app runs in guest-only mode:
# progress stays on the device and the sign-in screens show "Accounts aren't switched on yet".
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Database schema: run supabase/migrations/*.sql in the Supabase SQL editor (or `supabase db push`).
#
# Auth settings in the Supabase dashboard (Authentication):
# - URL Configuration: Site URL = https://sonopass.com, and add these redirect URLs:
#     https://sonopass.com/auth/callback
#     https://sonopass.com/reset-password
#     http://localhost:3000/auth/callback   (local development)
# - Providers: enable Email; enable Google and Apple with their client IDs/secrets.
